<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_settings.xml — Settings screen layout.

    Organized into sections matching the AppSettings data model:
    1. Display — device name shown in pickers
    2. Protocols — enable/disable AirPlay, Miracast, Cast
    3. AirPlay — PIN authentication
    4. Service — start on boot
    5. Developer — debug overlay
    6. About — version info, reset
    7. Permissions — accessibility, device admin

    KNOWN DEBT: this is a flat ScrollView, so every row inflates at once and none are recycled.
    Lint's TooManyViews is suppressed below rather than fixed, and the suppression is a real IOU:
    the screen has outgrown a hand-written layout and belongs in a RecyclerView, which would also
    make sections reorderable instead of being a fixed wall of XML. Suppressed rather than silently
    trimmed because dropping a setting to satisfy a lint count would be the wrong trade — but on the
    weakest Fire TV sticks this inflation cost is measurable, so it should not stay this way.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    tools:ignore="TooManyViews">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Page title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="32dp" />

        <!-- ── Section: Display ────────────────────────────────── -->
        <include layout="@layout/settings_section_header"
            android:id="@+id/header_display" />

        <!-- Display name row -->
        <LinearLayout
            android:id="@+id/row_display_name"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/focus_ring_selector"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_display_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/text_display_name_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Force higher mirroring resolution (1440p) -->
        <include layout="@layout/settings_toggle_row"
            android:id="@+id/row_force_high_res" />

        <!-- ── Section: Protocols ─────────────────────────────── -->
        <include layout="@layout/settings_section_header"
            android:id="@+id/header_protocols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <include layout="@layout/settings_toggle_row"
            android:id="@+id/row_airplay"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <include layout="@layout/settings_toggle_row"
            android:id="@+id/row_miracast"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <include layout="@layout/settings_toggle_row"
            android:id="@+id/row_dlna"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <include layout="@layout/settings_toggle_row"
            android:id="@+id/row_homekit"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <!-- Shown only while HomeKit is on: the pairing code is useless otherwise, and a stale
             code left on screen after switching HomeKit off would be actively misleading. -->
        <include layout="@layout/settings_toggle_row"
            android:id="@+id/row_remote_enabled"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <include layout="@layout/settings_toggle_row"
            android:id="@+id/row_homekit_reset"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <!-- ── Section: AirPlay ───────────────────────────────── -->
        <include layout="@layout/settings_section_header"
