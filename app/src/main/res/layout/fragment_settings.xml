<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_settings.xml — Settings, as two panes.

    Categories on the left, the rows of the selected category on the right. This replaced a single
    flat ScrollView holding all 33 rows at once, which is what made the screen feel
    finnicky on a remote: reaching About meant holding DOWN through everything above it, and the
    section headers were focus dead zones you passed through without landing on.

    Now the longest run of DOWN presses is the longest single category, and LEFT always returns to
    the category list.

    Every row keeps the id it had before, so SettingsFragment's binding code is untouched by the
    restructure; only the parent each row sits in has changed.

    ConstraintLayout rather than nested LinearLayouts, because the obvious nesting (a weighted row
    of two columns, each with a weighted ScrollView inside) makes every child measure twice —
    lint's NestedWeights, and it is right. Here the title and the scroller are positioned against
    the nav pane directly, so nothing is weighted and nothing measures twice.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:paddingHorizontal="@dimen/screen_margin_horizontal"
    android:paddingVertical="@dimen/screen_margin_vertical"
