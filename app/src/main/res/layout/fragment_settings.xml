                android:textSize="18sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
