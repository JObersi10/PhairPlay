<?xml version="1.0" encoding="utf-8"?>
<!--
    card_protocol_status.xml — one protocol, as an object rather than a row of text.

    Layout is icon / name / status / detail, top to bottom. The accent appears only in the icon
    chip and the status dot; the card body stays neutral so three cards side by side read as one
    system rather than three coloured rectangles.

    The card is focusable and animated by FocusMotion (scale + lift) and ProtocolCardAnimator
    (state transitions). Nothing here declares its own animation.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_md"
    android:background="@drawable/card_focus_selector"
    android:focusable="true">

    <ImageView
        android:id="@+id/img_protocol_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginBottom="@dimen/space_sm"
        android:padding="7dp"
        android:background="@drawable/icon_chip"
        android:src="@drawable/ic_airplay"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/text_protocol_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/space_xs" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_xs">

        <View
            android:id="@+id/dot_protocol_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@drawable/status_dot" />

        <TextView
            android:id="@+id/text_protocol_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_protocol_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
