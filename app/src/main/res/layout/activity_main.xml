<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — Root layout for MainActivity.

    The fragment container fills the window; the streaming overlay covers it when a stream is up.

    There was a permanent left nav panel here holding Home and Settings. It cost a whole column on
    every screen to switch between exactly two destinations, and inside Settings it produced three
    columns side by side — app nav, categories, rows — which is one more than anyone can track
    with a D-pad. Settings is reached from a button on Home now, and Back returns from it.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background">

    <!-- ── Main content area (fragments swap here) ────────────────────── -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Full-screen streaming overlay (GONE when idle) ─────────────── -->
    <com.phairplay.ui.TouchOverlayFrameLayout
        android:id="@+id/streaming_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
