<?xml version="1.0" encoding="utf-8"?>
<!-- A raised, non-focusable panel (the Home hero). The gradient runs light-at-top, which is what
     reads as "lit from above" and therefore as raised, without needing a shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/surface_top"
                android:endColor="@color/surface_bottom" />
            <corners android:radius="@dimen/card_corner_radius" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
