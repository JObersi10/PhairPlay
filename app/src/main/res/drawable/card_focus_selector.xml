<?xml version="1.0" encoding="utf-8"?>
<!-- Focus background for a tile with space around it (the protocol cards on Home).
     Focused: a lighter, bluer surface plus the accent ring. Unlike a list row, a card keeps a full
     surface at rest, because a card is meant to read as an object rather than a line in a list. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="@color/surface_focused_top"
                        android:endColor="@color/surface_focused_bottom" />
                    <corners android:radius="@dimen/card_corner_radius" />
                </shape>
            </item>
            <item android:inset="@dimen/focus_ring_inset">
                <shape android:shape="rectangle">
                    <stroke android:width="@dimen/focus_ring_width" android:color="@color/accent" />
                    <corners android:radius="@dimen/card_corner_radius" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/surface_top"
                android:endColor="@color/surface_bottom" />
            <corners android:radius="@dimen/card_corner_radius" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
