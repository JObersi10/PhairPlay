<?xml version="1.0" encoding="utf-8"?>
<!-- The one action the screen is offering right now. Carries an accent edge at rest so it reads as
     primary before anything is focused, and fills with the accent when it is focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="@dimen/row_corner_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_blue_pressed" />
            <corners android:radius="@dimen/row_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/surface_focused_top"
                android:endColor="@color/surface_focused_bottom" />
            <corners android:radius="@dimen/row_corner_radius" />
            <stroke android:width="1dp" android:color="@color/accent_dim" />
        </shape>
    </item>
</selector>
