<?xml version="1.0" encoding="utf-8"?>
<!-- Home's Start / Stop / Restart / Settings buttons. Focused fills with the accent itself rather
     than a grey surface: these are the only true actions on the screen, so when one is focused it
     should look like the thing that is about to happen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="@dimen/row_corner_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_blue_pressed" />
            <corners android:radius="@dimen/row_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/surface_top"
                android:endColor="@color/surface_bottom" />
            <corners android:radius="@dimen/row_corner_radius" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
