<?xml version="1.0" encoding="utf-8"?>
<!-- A destructive-ish action that should be reachable but never inviting (Stop). Nearly invisible
     at rest; only focus gives it a surface. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/row_focused" />
                    <corners android:radius="@dimen/row_corner_radius" />
                </shape>
            </item>
            <item android:inset="@dimen/focus_ring_inset">
                <shape android:shape="rectangle">
                    <stroke android:width="@dimen/focus_ring_width" android:color="@color/accent" />
                    <corners android:radius="@dimen/row_corner_radius" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/row_resting" />
            <corners android:radius="@dimen/row_corner_radius" />
        </shape>
    </item>
</selector>
