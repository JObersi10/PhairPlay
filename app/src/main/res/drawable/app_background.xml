<?xml version="1.0" encoding="utf-8"?>
<!-- The page itself. A vertical gradient rather than a flat fill, so surfaces drawn on top have
     something to be lighter than; on a flat black page every card reads as the same plane. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/bg_top"
        android:endColor="@color/bg_bottom" />
</shape>
