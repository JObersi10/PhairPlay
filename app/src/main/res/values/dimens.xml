<?xml version="1.0" encoding="utf-8"?>
<!--
    dimens.xml — the spacing and sizing scale.

    Everything on screen picks from this scale rather than inventing a number. Before this file the
    layouts used 32dp / 16dp / 12dp / 8dp more or less at random, which is why rows in different
    sections did not line up with each other.

    TV-specific notes:
      - Overscan. Televisions crop the edges of the picture, and how much varies by set. All
        top-level screens use @dimen/screen_margin_* so nothing important lands in the cropped band.
      - Touch targets are irrelevant here, but FOCUS targets are not: a row shorter than
        @dimen/row_height is hard to land on when holding a direction on the remote.
      - Text is read from about ten feet away. The type scale starts where a phone's would end.
-->
<resources>

    <!-- ─── Spacing scale ─────────────────────────────────────── -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="space_2xl">48dp</dimen>
    <dimen name="space_3xl">64dp</dimen>

    <!-- ─── Overscan-safe screen margins ──────────────────────── -->
    <!-- 5% horizontal / 5% vertical of 1080p, the figure Android's TV guidance uses. -->
    <dimen name="screen_margin_horizontal">48dp</dimen>
    <dimen name="screen_margin_vertical">27dp</dimen>

    <!-- ─── Rows and lists ────────────────────────────────────── -->
    <!-- Tall enough to be an easy focus target when scrolling by holding a direction. -->
    <dimen name="row_height">76dp</dimen>
    <dimen name="row_padding_horizontal">20dp</dimen>
    <dimen name="row_corner_radius">12dp</dimen>
    <!-- Rows sit flush; the focus ring provides the separation, so no gap is needed between them. -->
    <dimen name="row_spacing">2dp</dimen>

    <!-- ─── Focus ─────────────────────────────────────────────── -->
    <dimen name="focus_ring_width">3dp</dimen>
    <!-- The ring is drawn inside the row's bounds, so it needs room not to clip the text. -->
    <dimen name="focus_ring_inset">1dp</dimen>
    <dimen name="focus_elevation">8dp</dimen>

    <!-- ─── Cards and panels ──────────────────────────────────── -->
    <dimen name="card_corner_radius">16dp</dimen>
    <dimen name="card_padding">24dp</dimen>
    <dimen name="nav_panel_width">280dp</dimen>
    <dimen name="nav_item_height">56dp</dimen>

    <!-- ─── Type scale (10-foot) ──────────────────────────────── -->
    <dimen name="text_display">40sp</dimen>
    <dimen name="text_title">28sp</dimen>
    <dimen name="text_section">15sp</dimen>
    <dimen name="text_body">18sp</dimen>
    <dimen name="text_secondary">15sp</dimen>
    <dimen name="text_caption">13sp</dimen>

    <!-- ─── Icons ─────────────────────────────────────────────── -->
    <dimen name="icon_sm">20dp</dimen>
    <dimen name="icon_md">28dp</dimen>
    <dimen name="icon_lg">40dp</dimen>

</resources>
