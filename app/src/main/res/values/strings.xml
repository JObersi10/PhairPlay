    <!-- Permissions section -->
    <string name="settings_section_permissions">Permissions</string>
    <string name="setting_perm_on">Granted</string>
    <string name="setting_perm_off">Not granted</string>
    <string name="setting_perm_remote">Remote control outside PhairPlay</string>
    <string name="setting_perm_remote_granted">Granted. The remote can navigate outside PhairPlay — but Fire TV blocks the normal way to move the selection, so expect it to be unresponsive or to skip around on the home screen and in apps like Netflix. Root is the only way to make this reliable everywhere.</string>
    <string name="setting_remote">Remote control</string>
    <string name="setting_remote_subtitle">Reliable inside PhairPlay only. See Permissions.</string>

    <string name="setting_artwork_lookup">Find missing album art</string>
    <string name="setting_artwork_lookup_subtitle">Look up missing cover art online. Sends track names to MusicBrainz.</string>
    <string name="setting_backdrop">Backdrop</string>
    <string name="setting_backdrop_subtitle">What fills the screen behind the Now Playing card.</string>
    <string name="backdrop_dynamic">Dynamic</string>
    <string name="backdrop_dynamic_detail">Album colours across the whole screen, moving with the beat.</string>
    <string name="backdrop_projector">Projector</string>
    <string name="backdrop_projector_detail">Three orbs on true black, edges faded for projectors.</string>
    <string name="backdrop_black">Black</string>
    <string name="backdrop_black_detail">Plain black. No colour and nothing moving.</string>
    <string name="setting_stream_end">Exit when the stream ends</string>
    <string name="setting_stream_end_subtitle">Leave for the TV home screen when the sender stops</string>
    <string name="setting_perm_overlay">Show the remote\'s focus ring</string>
    <string name="setting_perm_overlay_granted">Granted. The remote draws its own highlight in apps that will not move theirs — the Fire TV launcher among them.</string>
    <string name="setting_perm_overlay_explanation">The Fire TV launcher refuses to move its highlight for the remote, so PhairPlay draws its own ring instead. Without this the remote still navigates and selects — you just cannot see where it is.</string>
    <string name="setting_perm_sleep">Turn the display off</string>
    <string name="setting_perm_sleep_granted">Granted. Turning PhairPlay off in the Home app blanks the display.\n\nNote: while this is on, PhairPlay cannot be uninstalled — Android blocks it for device admins. Revoke first if you want to remove the app.</string>
    <string name="setting_perm_revoke">Revoke</string>
    <string name="setting_perm_open_settings">Open Settings anyway</string>
    <string name="setting_perm_remote_adb">Fire TV does not list third-party accessibility services in its Settings menu, so this has to be granted over adb:\n\n%1$s\n\nEven once granted, expect the remote to be unresponsive or to skip around on the Fire TV home screen and in apps like Netflix. Fire TV blocks the way apps normally move the selection, so PhairPlay has to fake it with a drawn highlight and synthetic swipes. Inside PhairPlay the remote works properly. A rooted Fire TV can inject real button presses and is the only way to get this working everywhere.</string>
    <string name="setting_perm_sleep_explanation">Lets PhairPlay blank the display when you turn it off from the Home app. Nothing else uses this.</string>
    <string name="setting_perm_no_screen">This Fire TV has no screen for that permission. Grant it from a computer instead:\n\n%1$s</string>

