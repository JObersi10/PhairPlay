    <!-- HomeKit setup flow -->
    <string name="hk_ask_title">Add to Apple Home?</string>
    <string name="hk_ask_body">HomeKit lets you turn this TV on and off from the Home app, control it with the remote on your iPhone\'s Control Center, and use Siri. Everything works over your local network — no account and no internet needed.</string>
    <string name="hk_ask_yes">Yes, set it up</string>
    <string name="hk_ask_no">Not now</string>

    <string name="hk_code_title">Add it in the Home app</string>
    <string name="hk_code_body">On your iPhone or iPad, follow these steps. Scan the code with the camera to skip the typing.</string>
    <string name="hk_code_body_named">On your iPhone or iPad, follow these steps. This TV appears as \"%1$s\" — that is its hardware name, not the AirPlay name. Scan the code with the camera to skip the typing.</string>
    <string name="hk_step_open_home">Open the Home app</string>
    <string name="hk_step_add">Tap + then Add Accessory</string>
    <string name="hk_step_more_options">Tap More options…</string>
