    <string name="onboarding_perm_notifications_why">Shows the persistent status while a stream is active. Android requires it for the background receiver.</string>
    <string name="onboarding_perm_location">Location</string>
    <string name="onboarding_perm_location_why">Android gates Wi\u2011Fi Direct discovery behind location on this version. Only needed for Miracast — PhairPlay never reads your position.</string>
    <string name="onboarding_perm_overlay">Open app automatically</string>
    <string name="onboarding_perm_overlay_why">Lets PhairPlay come to the foreground by itself when a device connects. Without it you get a notification you have to click.</string>
