    <!-- Onboarding -->
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_done">Start using PhairPlay</string>
    <string name="onboarding_welcome_title">Welcome to PhairPlay</string>
    <string name="onboarding_welcome_body">Turn this TV into an AirPlay and DLNA receiver. Send audio, video and photos from an iPhone, iPad or Mac — no cables, no account.\n\nThis takes about a minute to set up.</string>
    <string name="onboarding_required_title">Required permissions</string>
    <string name="onboarding_required_body">PhairPlay needs these to receive streams at all.</string>
    <string name="onboarding_required_none">Nothing to grant — this device gives PhairPlay everything it needs at install time.</string>
    <string name="onboarding_optional_title">Recommended</string>
    <string name="onboarding_optional_body">Optional, but PhairPlay works noticeably better with them.</string>
    <string name="onboarding_ready_title">You\'re set</string>
    <string name="onboarding_ready_body">PhairPlay is advertising on your network. Open Control Centre on your iPhone, tap Screen Mirroring and pick this TV — or tap the AirPlay icon inside an app like YouTube to send a video at full quality instead of mirroring.\n\nWhile music is playing, play/pause and skip on the remote control the phone, and MENU moves the Now Playing card.\n\nAll of this can be changed later in Settings.</string>
    <string name="onboarding_perm_notifications">Notifications</string>
    <string name="onboarding_perm_notifications_why">Shows the persistent status while a stream is active. Android requires it for the background receiver.</string>
    <string name="onboarding_perm_location">Location</string>
    <string name="onboarding_perm_location_why">Android gates Wi\u2011Fi Direct discovery behind location on this version. Only needed for Miracast — PhairPlay never reads your position.</string>
    <string name="onboarding_perm_overlay">Open app automatically</string>
    <string name="onboarding_perm_overlay_why">Lets PhairPlay come to the foreground by itself when a device connects. Without it you get a notification you have to click.</string>
    <string name="onboarding_grant">Grant</string>
    <string name="onboarding_granted">Granted</string>
    <string name="onboarding_open_settings">Open settings</string>
    <string name="onboarding_overlay_adb_hint">Fire TV has no screen for this permission — Amazon does not ship one. Without it PhairPlay cannot open itself when a sender connects; you tap the notification instead. To grant it, run from a computer:  adb shell appops set com.phairplay.firetv SYSTEM_ALERT_WINDOW allow</string>
