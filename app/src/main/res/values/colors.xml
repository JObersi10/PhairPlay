<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ─── Backgrounds ─────────────────────────────────────── -->
    <!-- True black — best for OLED, minimal visual noise on TV -->
    <color name="background_dark">#FF0B0E15</color>
    <!-- Surface elevation: cards, sheets, nav panel -->
    <color name="background_surface">#FF1C1C1E</color>
    <!-- Slightly lighter surface for hover/pressed states -->
    <color name="background_surface_elevated">#FF2C2C2E</color>
    <!-- Dividers and separators -->
    <color name="divider">#FF38383A</color>

    <!-- ─── Text ─────────────────────────────────────────────── -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#FF8E8E93</color>
    <color name="text_tertiary">#FF636366</color>
    <color name="text_on_accent">#FFFFFFFF</color>

    <!-- ─── Accent (Google TV blue) ─────────────────────────── -->
    <color name="accent_blue">#FF1A73E8</color>
    <color name="accent_blue_pressed">#FF1557B0</color>
    <color name="focus_ring">#FF4C9AFF</color>

    <!-- ─── Protocol status colors ──────────────────────────── -->
    <!-- Green: service running / connected -->
    <color name="status_running">#FF34C759</color>
    <!-- Red: service stopped / error -->
    <color name="status_stopped">#FFFF3B30</color>
    <!-- Gray: service disabled by user -->
    <color name="status_disabled">#FF636366</color>
    <!-- Yellow: service starting / restarting -->
    <color name="status_transitioning">#FFFFD60A</color>

    <!-- ─── Protocol brand colors ────────────────────────────── -->
    <!-- AirPlay: Apple silver-blue -->
    <color name="protocol_airplay">#FF5AC8FA</color>
    <!-- Miracast: neutral teal -->
    <color name="protocol_miracast">#FF30D158</color>
    <!-- Cast: Google blue -->
    <color name="protocol_cast">#FF4285F4</color>

    <!-- ─── Navigation ────────────────────────────────────────── -->
    <color name="nav_panel_background">#FF111111</color>
    <color name="nav_item_selected">#FF1A73E8</color>
    <color name="nav_item_normal">#FF8E8E93</color>

    <!-- ─── Row states (see drawable/row_focus_selector.xml) ─── -->
    <!-- Focused rows get a real surface; unfocused ones are transparent, so exactly one row on
         the screen is ever filled and the eye has nothing to compete with. -->
    <color name="row_focused">#FF2C2C2E</color>
    <color name="row_pressed">#FF3A3A3C</color>
    <!-- Selected but focus has moved to another pane: quiet enough not to look focused, visible
         enough to keep the user's place. -->
    <color name="row_selected_unfocused">#26FFFFFF</color>
    <!-- Resting surface for every row. Present so no row reads as unfinished next to its
         neighbours, faint enough that the focused row still wins by a wide margin. -->
    <color name="row_resting">#0FFFFFFF</color>

    <!-- ─── Focus ring ────────────────────────────────────────── -->
    <!-- Brighter than accent_blue. The ring sits on a dark surface at ten feet, where the
         Google-blue #1A73E8 is legible on a monitor and muddy on a television. -->
    <color name="focus_ring_bright">#FF4C9AFF</color>

    <!-- ─── Depth ─────────────────────────────────────────────── -->
    <!-- The page is a very dark blue rather than pure black, and it lightens toward the top. On an
         OLED true black is the right call for a *video* surface; for a UI surface it flattens
         everything into one plane, because nothing can ever sit behind anything else. A few points
         of blue give the surfaces something to be lighter than. -->
    <color name="bg_top">#FF141821</color>
    <color name="bg_bottom">#FF070910</color>

    <!-- Card surfaces, as a gradient rather than a flat fill: the top edge catches slightly more
         light, which is what makes a rectangle read as a raised panel instead of a grey box. -->
    <color name="surface_top">#FF23283A</color>
    <color name="surface_bottom">#FF191D2A</color>
    <color name="surface_focused_top">#FF33405E</color>
    <color name="surface_focused_bottom">#FF232B40</color>

    <!-- A more saturated accent than the Google-blue it replaces; that one goes muddy against a
         dark surface at ten feet. -->
    <color name="accent">#FF4C9AFF</color>
    <color name="accent_dim">#332F7FE0</color>

    <!-- Protocol identity colours, used for the icon chip on each Home card so the three are
         distinguishable at a glance rather than three identical grey tiles. -->
    <color name="chip_airplay">#FF5AC8FA</color>
    <color name="chip_dlna">#FF7C6CFF</color>
    <color name="chip_miracast">#FF30D158</color>
</resources>
