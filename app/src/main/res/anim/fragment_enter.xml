<?xml version="1.0" encoding="utf-8"?>
<!-- Entering a screen: rises slightly and fades in. Short — a TV transition that outlasts the
     remote's own repeat rate feels like lag rather than polish. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="220" />
    <translate android:fromYDelta="3%p" android:toYDelta="0" android:duration="220" />
</set>
