<?xml version="1.0" encoding="utf-8"?>
<!-- Coming back: falls from above rather than rising, so the direction reads as "back". -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="220" />
    <translate android:fromYDelta="-2%p" android:toYDelta="0" android:duration="220" />
</set>
